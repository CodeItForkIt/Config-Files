from http.server import HTTPServer, BaseHTTPRequestHandler\
import subprocess\
import json\
\
FAKE_RESPONSES = {\
    # catch anything that looks like a version/update check\
    "version": '{"version":"0.0.0"}',\
    "update": '{"version":"0.0.0"}',\
    "release": '{"tag_name":"v0.0.0","assets":[]}',\
}\
\
class Handler(BaseHTTPRequestHandler):\
    def do_GET(self):\
        path = self.path.lower()\
        print(f"REQUEST: {self.path}")\
\
        # Check if it looks like an update check\
        for key, fake in FAKE_RESPONSES.items():\
            if key in path:\
                data = fake.encode()\
                self.send_response(200)\
                self.send_header("Content-Type", "application/json")\
                self.send_header("Content-Length", str(len(data)))\
                self.end_headers()\
                self.wfile.write(data)\
                print(f"  -> Intercepted as update check, returned fake response")\
                return\
\
        # Otherwise proxy to Scryfall\
        url = "https://api.scryfall.com" + self.path\
        result = subprocess.run([\
            "curl", "-s", "--max-time", "10",\
            "-H", "User-Agent: Pisces/1.0",\
            "-H", "Accept: application/json",\
            url\
        ], capture_output=True)\

