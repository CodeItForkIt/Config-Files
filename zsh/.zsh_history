: 1774666015:0;for f in *.md; do\
  # Split into parts\
  IFS='-' read -ra parts <<< "${f%.md}"\
  \
  # Remove first part (class name)\
  parts=("${parts[@]:1}")\
  \
  # Remove trailing source tag if present\
  source_tags=("xphb" "efa" "tce" "xdmg")\
  last="${parts[-1]}"\
  for tag in "${source_tags[@]}"; do\
    [[ "${last,,}" == "$tag" ]] && parts=("${parts[@]::${#parts[@]}-1}") && break\
  done\
  \
  # Remove new first part if it's also a source tag\
  first="${parts[0]}"\
  for tag in "${source_tags[@]}"; do\
    [[ "${first,,}" == "$tag" ]] && parts=("${parts[@]:1}") && break\
  done\
  \
  # Title-case and join with spaces\
  new_name=""\
  for part in "${parts[@]}"; do\
    new_name+="${part^} "\
  done\
  new_name="${new_name% }.md"\
  \
  mv "$f" "$new_name"\
done
: 1774666044:0;for f in *.md; do\
  local_stem="${f%.md}"\
  parts=("${(@s:-:)local_stem}")\
  \
  # Remove first part (class name)\
  parts=("${parts[@]:1}")\
  \
  # Remove trailing source tag if present\
  source_tags=(xphb efa tce xdmg)\
  last="${parts[-1]}"\
  for tag in $source_tags; do\
    [[ "${last:l}" == "$tag" ]] && parts=("${parts[@]:0:-1}") && break\
  done\
  \
  # Remove new first part if it's also a source tag\
  first="${parts[1]}"\
  for tag in $source_tags; do\
    [[ "${first:l}" == "$tag" ]] && parts=("${parts[@]:1}") && break\
  done\
  \
  # Title-case and join with spaces\
  new_name="${(C)${(j: :)parts}}.md"\
  \
  echo "$f" "$new_name"\
done
