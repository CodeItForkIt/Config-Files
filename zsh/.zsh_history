: 1780159670:0;cd ~/.local/share/Steam\
python3 -c "\
import lzma, zipfile, io, glob\
\
for path in glob.glob('package/*.vz.*'):\
    try:\
        with open(path, 'rb') as f:\
            raw = f.read()\
        # VZip: 'VZa' header + 1 byte version + 4 byte timestamp + lzma data + 4 byte crc + 'VZa'\
        if raw[:3] != b'VZa':\
            print(f'SKIP (not VZa): {path}')\
            continue\
        lzma_data = raw[8:-8]\
        data = lzma.decompress(lzma_data)\
        zf = zipfile.ZipFile(io.BytesIO(data))\
        zf.extractall('.')\
        print(f'OK: {path}')\
    except Exception as e:\
        print(f'FAIL: {path}: {e}')\
"
