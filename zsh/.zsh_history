import json, glob, os\
\
fixed = 0\
for path in glob.glob('5etools-src/data/**/*.json', recursive=True):\
    data = json.load(open(path))\
    changed = False\
    for sub in data.get('subrace', []):\
        if not sub.get('raceName'):\
            copy_race = sub.get('_copy', {}).get('raceName')\
            if copy_race:\
                sub['raceName'] = copy_race\
                changed = True\
                fixed += 1\
                print(f"Fixed: {path} | {sub.get('name')} ⃦�� raceName={copy_race}")\
            else:\
                print(f"UNFIXABLE: {path} | {json.dumps(sub)[:150]}")\
    if changed:\
        json.dump(data, open(path, 'w'), indent='\t')\
\
print(f"\nTotal fixed: {fixed}")\
EOF
: 1774650731:0;python3 - <<'EOF'\
import json, glob\
\
fixed = 0\
for path in glob.glob('5etools-src/data/**/*.json', recursive=True):\
    try:\
        data = json.load(open(path))\
    except json.JSONDecodeError:\
        continue\
    if not isinstance(data, dict):\
        continue\
    subraces = data.get('subrace', [])\
    if not isinstance(subraces, list):\
        continue\
    changed = False\
    for sub in subraces:\
        if not isinstance(sub, dict):\
            print(f"WEIRD: {path} | subrace entry is not a dict: {str(sub)[:100]}")\
            continue\
        if not sub.get('raceName'):\
            copy_race = sub.get('_copy', {}).get('raceName')\
            if copy_race:\
                sub['raceName'] = copy_race\
                changed = True\
                fixed += 1\
                print(f"Fixed: {path} | {sub.get('name')} ⃦�� raceName={copy_race}")\
            else:\
                print(f"UNFIXABLE: {path} | {json.dumps(sub)[:150]}")\
    if changed:\
        with open(path, 'w') as f:\
            json.dump(data, f, indent='\t')\
\
print(f"\nTotal fixed: {fixed}")\
EOF
: 1774650768:0;python3 - <<'EOF'\
import json, glob\
\
fixed = 0\
for path in glob.glob('5etools-src/data/**/*.json', recursive=True):\
    try:\
        data = json.load(open(path))\
    except json.JSONDecodeError:\
        continue\
    if not isinstance(data, dict):\
        continue\
    subraces = data.get('subrace', [])\
    if not isinstance(subraces, list):\
        continue\
    changed = False\
    for sub in subraces:\
        if not isinstance(sub, dict):\
            continue\
        copy = sub.get('_copy', {})\
        for field in ('raceName', 'raceSource'):\
            if not sub.get(field):\
                val = copy.get(field)\
                if val:\
                    sub[field] = val\
                    changed = True\
                    fixed += 1\
                    print(f"Fixed: {path} | {sub.get('name')} ⃦�� {field}={val}")\
                else:\
                    print(f"UNFIXABLE: {path} | {sub.get('name')} missing {field} | {json.dumps(sub)[:150]}")\
    if changed:\
        with open(path, 'w') as f:\
            json.dump(data, f, indent='\t')\
\
print(f"\nTotal fixed: {fixed}")\
EOF
