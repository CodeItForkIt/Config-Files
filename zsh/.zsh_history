: 1774125383:0;python3 -c "\
import struct, zlib\
\
data = open('/usr/lib/floorp/browser/omni.ja', 'rb').read()\
\
# Local file header starts with PK\x03\x04\
# Find the one just before offset 56535\
for offset in [56535, 2477628, 11589462, 12221602, 12961750]:\
    # Walk back to find PK\x03\x04 signature\
    pos = offset\
    while pos > 0 and data[pos:pos+4] != b'PK\x03\x04':\
        pos -= 1\
    if data[pos:pos+4] != b'PK\x03\x04':\
        continue\
    # Parse local file header\
    comp_method = struct.unpack_from('<H', data, pos+8)[0]\
    comp_size = struct.unpack_from('<I', data, pos+18)[0]\
    fname_len = struct.unpack_from('<H', data, pos+26)[0]\
    extra_len = struct.unpack_from('<H', data, pos+28)[0]\
    data_start = pos + 30 + fname_len + extra_len\
    fname = data[pos+30:pos+30+fname_len].decode()\
    if 'activity-stream.css' not in fname:\
        continue\
    print(f'File: {fname}, method: {comp_method}, size: {comp_size}')\
    raw = data[data_start:data_start+comp_size]\
    if comp_method == 8:\
        text = zlib.decompress(raw, -15).decode()\
    else:\
        text = raw.decode()\
    for line in text.splitlines():\
        if 'background' in line.lower() and any(x in line.lower() for x in ['html','body','root']):\
            print(line)\
"
