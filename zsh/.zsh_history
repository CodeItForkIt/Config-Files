python3 -c "\
import struct, lzma, zipfile, io, os, glob\
\
for path in glob.glob('package/*.vz*'):\
    try:\
        with open(path, 'rb') as f:\
            magic = f.read(4)\
            if magic != b'VZip':\
                continue\
            f.read(5)  # version + timestamp\
            data = lzma.decompress(f.read()[:-10])\
            zf = zipfile.ZipFile(io.BytesIO(data))\
            zf.extractall('.')\
            print(f'OK: {path}')\
    except Exception as e:\
        print(f'FAIL: {path}: {e}')\
"
