    extra_len = struct.unpack_from('<H', data, pos+28)[0]\
    comp_size = struct.unpack_from('<I', data, pos+18)[0]\
    data_start = pos + 30 + fname_len + extra_len\
    fname = data[pos+30:pos+30+fname_len].decode(errors='ignore')\
