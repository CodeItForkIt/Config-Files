: 1773806344:0;cat > ~/scryfall-bridge.py << 'ENDOFFILE'\
from http.server import HTTPServer, BaseHTTPRequestHandler\
import subprocess\
\
FAKE_RESPONSES = {\
    "version": '{"version":"0.0.0"}',\
    "update": '{"version":"0.0.0"}',\
    "release": '{"tag_name":"v0.0.0","assets":[]}',\
}\
\
class Handler(BaseHTTPRequestHandler):\
    def do_GET(self):\
        path = self.path.lower()\
        print(f"REQUEST: {self.path}")\
        for key, fake in FAKE_RESPONSES.items():\
            if key in path:\
                data = fake.encode()\
                self.send_response(200)\
                self.send_header("Content-Type", "application/json")\
                self.send_header("Content-Length", str(len(data)))\
                self.end_headers()\
                self.wfile.write(data)\
                return\
        url = "https://api.scryfall.com" + self.path\
        result = subprocess.run(["curl", "-s", "--max-time", "10", "-H", "User-Agent: Pisces/1.0", "-H", "Accept: application/json", url], capture_output=True)\
        data = result.stdout\
        self.send_response(200)\
        self.send_header("Content-Type", "application/json")\
        self.send_header("Content-Length", str(len(data)))\
        self.end_headers()\
        self.wfile.write(data)\
    def log_message(self, *args): pass\
\
HTTPServer(("127.0.0.1", 8081), Handler).serve_forever()\
ENDOFFILE\
\
python ~/scryfall-bridge.py &\
sleep 1\
curl -s http://127.0.0.1:8081/cards/search\?q\=opt | head -c 100
