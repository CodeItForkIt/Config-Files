# ── Noctalia/matugen generated theme outputs ────────────────
# Rewritten on every wallpaper rotation (Material-You re-theme); derived
# from the current wallpaper + noctalia settings, not hand-edited. Confirmed
# via git history: some of these were committed 1000+ times.
btop/themes/noctalia.theme
gtk-3.0/noctalia.css
kitty/themes/noctalia.conf
kitty/themes/Matugen.conf
qt5ct/colors/noctalia.conf
qt6ct/colors/noctalia.conf
